# Copy to .env.local and fill in. All of these are exposed to the browser
# (NEXT_PUBLIC_) -- none of them are secret; the backend URL and contract id
# are public by nature, and nothing sensitive (voter secrets, proofs) ever
# goes through env vars.

# anonvote-backend's base URL.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Must match anonvote-backend's ANONVOTE_CONTRACT_ID and the network below.
NEXT_PUBLIC_CONTRACT_ID=CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Used to build/simulate the register transaction Freighter signs, and to
# tell Freighter which network to sign for.
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
